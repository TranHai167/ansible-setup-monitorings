#!/bin/bash
# Docker Container Metrics for node_exporter textfile collector
# Outputs cAdvisor-compatible metric names so existing Grafana dashboards work
# Collects via: docker stats --no-stream

PROM_FILE="{{ docker_exporter_textfile_path }}/docker_containers.prom"
TMP_FILE="${PROM_FILE}.tmp"

convert_to_bytes() {
  local val="$1"
  local num unit
  num=$(echo "$val" | grep -oP '[\d.]+')
  unit=$(echo "$val" | grep -oP '[a-zA-Z]+')
  case "$unit" in
    B|b)       awk "BEGIN{printf \"%.0f\", $num}" ;;
    kB|KB|k)   awk "BEGIN{printf \"%.0f\", $num * 1024}" ;;
    KiB)       awk "BEGIN{printf \"%.0f\", $num * 1024}" ;;
    MB|M|MiB)  awk "BEGIN{printf \"%.0f\", $num * 1048576}" ;;
    GB|G|GiB)  awk "BEGIN{printf \"%.0f\", $num * 1073741824}" ;;
    TB|T|TiB)  awk "BEGIN{printf \"%.0f\", $num * 1099511627776}" ;;
    *)         awk "BEGIN{printf \"%.0f\", $num}" ;;
  esac
}

{
  echo "# HELP container_memory_usage_bytes Memory usage in bytes per container"
  echo "# TYPE container_memory_usage_bytes gauge"
  echo "# HELP container_cpu_usage_percent CPU usage percentage per container"
  echo "# TYPE container_cpu_usage_percent gauge"
  echo "# HELP container_last_seen Last time container was seen (unix timestamp)"
  echo "# TYPE container_last_seen gauge"
  echo "# HELP container_network_rx_bytes Network received bytes per container"
  echo "# TYPE container_network_rx_bytes gauge"
  echo "# HELP container_network_tx_bytes Network transmitted bytes per container"
  echo "# TYPE container_network_tx_bytes gauge"

  NOW=$(date +%s)

  docker stats --no-stream --format '{{ '{{' }}json .{{ '}}' }}' 2>/dev/null | while IFS= read -r stats; do
    name=$(echo "$stats" | jq -r '.Name')
    id=$(echo "$stats" | jq -r '.ID')

    [ "$name" = "null" ] || [ -z "$name" ] && continue

    image=$(docker inspect --format '{{ '{{' }}.Config.Image{{ '}}' }}' "$id" 2>/dev/null)

    labels="id=\"/docker/${id}\",name=\"${name}\",image=\"${image}\""

    cpu=$(echo "$stats" | jq -r '.CPUPerc' | tr -d '%')

    mem_usage_raw=$(echo "$stats" | jq -r '.MemUsage' | awk -F'/' '{print $1}' | xargs)
    net_rx_raw=$(echo "$stats" | jq -r '.NetIO' | awk -F'/' '{print $1}' | xargs)
    net_tx_raw=$(echo "$stats" | jq -r '.NetIO' | awk -F'/' '{print $2}' | xargs)

    mem_usage_bytes=$(convert_to_bytes "$mem_usage_raw")
    net_rx_bytes=$(convert_to_bytes "$net_rx_raw")
    net_tx_bytes=$(convert_to_bytes "$net_tx_raw")

    echo "container_memory_usage_bytes{${labels}} ${mem_usage_bytes}"
    echo "container_cpu_usage_percent{${labels}} ${cpu}"
    echo "container_last_seen{${labels}} ${NOW}"
    echo "container_network_rx_bytes{${labels}} ${net_rx_bytes}"
    echo "container_network_tx_bytes{${labels}} ${net_tx_bytes}"
  done
} > "$TMP_FILE"

mv "$TMP_FILE" "$PROM_FILE"
