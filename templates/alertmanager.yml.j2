route:
  receiver: "email"
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - match:
        severity: critical
      repeat_interval: 1h

receivers:
  - name: "email"
    email_configs:
      - to: "{{ alert_to_email }}"
        from: "{{ alert_from_email }}"
        smarthost: "{{ smtp_host }}:{{ smtp_port }}"
        auth_username: "{{ smtp_user }}"
        auth_password: "{{ smtp_password }}"
        auth_identity: "{{ smtp_user }}"
        require_tls: true
        send_resolved: true
        headers:
          Subject: '{% raw %}[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }} - {{ .CommonLabels.instance_name | default "unknown" }}{% endraw %}'
